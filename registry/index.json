{
  "marketplace": {
    "name": "shared-skill-marketplace",
    "description": "Shared skill marketplace for Codex, Claude Code, and CodeBuddy",
    "source": "local-registry",
    "version": "1"
  },
  "packs": [
    {
      "name": "starter-pack",
      "version": "1.0.0",
      "description": "Starter pack with two reusable workflow skills",
      "author": {
        "name": "Local Publisher"
      },
      "license": "MIT",
      "tags": ["starter", "workflow"],
      "source": "./packs/starter-pack",
      "platformSupport": {
        "codex": true,
        "claude": true,
        "codebuddy": true
      },
      "install": {
        "unit": "pack"
      },
      "contents": {
        "skills": ["writing-clearly", "release-checklist"]
      }
    },
    {
      "name": "floating-island-hooks",
      "version": "1.0.0",
      "description": "Project-local Floating Island hooks for CodeBuddy, Claude Code, and Codex",
      "author": {
        "name": "Local Publisher"
      },
      "license": "MIT",
      "tags": ["floating-island", "hooks", "status", "codebuddy", "claude", "codex"],
      "source": "./packs/floating-island-hooks",
      "platformSupport": {
        "codex": true,
        "claude": true,
        "codebuddy": true
      },
      "install": {
        "unit": "pack"
      },
      "contents": {
        "skills": ["project-floating-island-hooks"]
      }
    },
    {
      "name": "svn-toolkit",
      "version": "1.0.0",
      "description": "通用 SVN 技能与命令集合，适配 Codex、Claude Code 和 CodeBuddy",
      "author": {
        "name": "Local Publisher"
      },
      "license": "MIT",
      "tags": ["svn", "subversion", "command", "workflow", "chinese"],
      "source": "./packs/svn-toolkit",
      "platformSupport": {
        "codex": true,
        "claude": true,
        "codebuddy": true
      },
      "install": {
        "unit": "pack"
      },
      "contents": {
        "skills": ["svn-workflow"],
        "commands": [
          "SVN-info",
          "SVN-log",
          "SVN-status",
          "SVN-diff",
          "SVN-update",
          "SVN-add",
          "SVN-delete",
          "SVN-revert",
          "SVN-commit",
          "SVN-resolve",
          "SVN-blame",
          "SVN-list",
          "SVN-switch",
          "SVN-cleanup"
        ]
      }
    }
  ]
}
