{
  "name": "svn-toolkit",
  "version": "1.0.0",
  "description": "通用 SVN 技能与命令集合，适配 Codex、Claude Code 和 CodeBuddy",
  "author": {
    "name": "Local Publisher"
  },
  "license": "MIT",
  "tags": [
    "svn",
    "subversion",
    "command",
    "workflow",
